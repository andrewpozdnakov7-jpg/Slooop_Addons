{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/andrewpozdnakov7-jpg/Slooop_Addons/main/wallpapers.schema.json",
  "title": "Slooop wallpaper catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "wallpapers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "wallpapers": {
      "type": "array",
      "items": { "$ref": "#/$defs/wallpaper" }
    }
  },
  "$defs": {
    "wallpaper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "author", "license", "imageUrl", "previewUrl",
        "sha256", "width", "height", "fileSizeBytes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "imageUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "previewUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fileSizeBytes": { "type": "integer", "minimum": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
